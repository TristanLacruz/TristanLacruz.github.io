---
import { getCollection, render } from 'astro:content';
import CaseLayout from '../../layouts/CaseLayout.astro';

export async function getStaticPaths() {
  const cases = (
    await getCollection('work', ({ data }) =>
      import.meta.env.PROD ? !data.draft : true
    )
  ).sort((a, b) => a.data.order - b.data.order);

  return cases.map((entry, index) => {
    const prevEntry = cases[index - 1] ?? null;
    const nextEntry = cases[index + 1] ?? null;

    return {
      params: { id: entry.id },
      props: {
        entry,
        prev: prevEntry
          ? { id: prevEntry.id, title: prevEntry.data.title }
          : null,
        next: nextEntry
          ? { id: nextEntry.id, title: nextEntry.data.title }
          : null,
      },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<CaseLayout entry={entry} prev={prev} next={next}>
  <Content />
</CaseLayout>
