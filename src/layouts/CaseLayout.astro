---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import MetricStrip from '../components/MetricStrip.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  prev: { id: string; title: string } | null;
  next: { id: string; title: string } | null;
}

const { entry, prev, next } = Astro.props;
const { title, deck, eyebrow, metrics, repo, notebook } = entry.data;
---

<BaseLayout title={`${title} — Tristán Lacruz`} description={deck}>
  <article>
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-stack-1 max-w-prose text-h1">{title}</h1>
    <p class="mt-stack-2 max-w-prose deck">{deck}</p>

    <div class="mt-stack-3">
      <MetricStrip metrics={metrics} />
    </div>

    <div class="prose mt-stack-3">
      <slot />
    </div>

    {
      (repo || notebook) && (
        <p class="mt-stack-3 text-small">
          {repo && <a href={repo} rel="noopener">Repository</a>}
          {repo && notebook && <span class="text-ink-2"> · </span>}
          {notebook && <a href={notebook} rel="noopener">Notebook</a>}
        </p>
      )
    }
  </article>

  {
    (prev || next) && (
      <nav
        aria-label="Other cases"
        class="mt-stack-4 flex justify-between gap-stack-2 border-t border-rule pt-stack-2 text-small"
      >
        <div>
          {prev && (
            <a href={`/work/${prev.id}/`}>
              <span aria-hidden="true">← </span>
              {prev.title}
            </a>
          )}
        </div>
        <div class="text-right">
          {next && (
            <a href={`/work/${next.id}/`}>
              {next.title}
              <span aria-hidden="true"> →</span>
            </a>
          )}
        </div>
      </nav>
    )
  }
</BaseLayout>